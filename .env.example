NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# After applying supabase/migrations/0004_*.sql, sync CSV → DB:
#   npm run db:load-enriched

OPENAI_API_KEY=

GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEETS_ID=

# Google Places API (Places API New billing enabled project); used by scripts/backfill-google-place-ids.ts
GOOGLE_PLACES_API_KEY=

# Optional: comma-separated domains allowed for PDF/web URL import (e.g. ca.gov,sandiegocounty.gov). Leave empty to allow any https host that passes DNS safety checks.
IMPORT_FETCH_ALLOWED_HOSTS=

# ── Enrichment worker ──────────────────────────────
ENRICHMENT_GLOBAL_CONCURRENCY=3
ENRICHMENT_PER_HOST_CONCURRENCY=1
ENRICHMENT_REQUEST_DELAY_MS=1500
ENRICHMENT_POLL_INTERVAL_S=5
ENRICHMENT_MAX_RETRIES=2
